# === โปรเจกต์ Supabase ===
# 1) สร้าง project ที่ supabase.com
# 2) วาง URL + anon key
# 3) รัน database.sql แล้วรัน scripts/setup-storage-uploads.sql
# 4) yarn db:verify
#
# สินค้าเดิมในแคตตาล็อก → public/images ในโปรเจกต์ (commit แล้ว deploy)
# รูปร้าน + สินค้าที่อัปโหลดใหม่ + แชท/KYC/หมวด/สไลด์ → Supabase Storage bucket uploads
# curently 
VITE_SUPABASE_URL=https://exxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your anon key

# Vercel production: ตั้งสองค่านี้ใน Project Settings → Environment Variables
# แล้ว Redeploy — Vite อ่านเฉพาะตอน build ไม่ได้อ่าน .env จากเครื่องคุณ

# สำหรับสคริปต์เท่านั้น (อย่า commit ค่าจริง)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CDN override สำหรับรูปสินค้า/ร้านในโปรเจกต์ (ไม่บังคับ)
# VITE_ASSET_BASE=https://cdn.example.com

# Override URL Storage (ค่าเริ่มต้น = {VITE_SUPABASE_URL}/storage/v1/object/public/uploads)
# VITE_STORAGE_ASSET_BASE=https://YOUR_NEW_PROJECT.supabase.co/storage/v1/object/public/uploads
