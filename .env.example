# === โปรเจกต์ Supabase ใหม่ ===
# 1) สร้าง project ที่ supabase.com
# 2) วาง URL + anon key ด้านล่าง
# 3) รัน database.sql ใน SQL Editor
# 4) yarn db:verify
#
# ไม่ต้องตั้ง Storage สำหรับรูปสินค้า/ร้าน — ไฟล์อยู่ที่ public/images

VITE_SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ใช้กับสคริปต์เท่านั้น (อย่า commit ค่าจริง)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CDN override (ไม่บังคับ)
# VITE_ASSET_BASE=https://cdn.example.com
