VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# สำหรับสคริปต์ mirror รูป (scripts/mirror-images-to-supabase.mjs) — อย่า commit ค่าจริง
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# แหล่งรูป live (default ใช้ reference site)
# LIVE_ASSET_BASE=https://ffshoppingx9.bigselashoping.org/marketting

# Storage bucket (default: uploads)
# SUPABASE_STORAGE_BUCKET=uploads

# รูปสินค้า/สไลด์ — ค่าเริ่มต้นใช้ Supabase Storage bucket uploads
# VITE_ASSET_BASE=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/uploads
