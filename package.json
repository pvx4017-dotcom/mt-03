{
  "name": "meta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "node scripts/generate-database-sql.mjs",
    "db:verify": "node scripts/verify-new-supabase.mjs",
    "images:pull": "node scripts/pull-catalog-images-to-public.mjs",
    "images:pull:dry": "node scripts/pull-catalog-images-to-public.mjs --dry-run",
    "images:pull:storage": "node scripts/probe-storage-and-pull.mjs --skip-existing",
    "images:purge-storage": "node scripts/purge-catalog-from-storage.mjs",
    "images:purge-storage:dry": "node scripts/purge-catalog-from-storage.mjs --dry-run",
    "images:audit": "node scripts/audit-local-images.mjs",
    "images:mirror": "node -e \"console.error('Deprecated: อย่า mirror ไป Supabase Storage — ใช้ yarn images:pull ลง public/'); process.exit(1)\"",
    "images:mirror:dry": "node -e \"console.error('Deprecated: ใช้ yarn images:pull:dry'); process.exit(1)\"",
    "brand:fetch": "node scripts/fetch-brand-assets.mjs",
    "test:e2e": "node scripts/e2e-smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/kanit": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
